# Copy to apps/server/.env for local development (docker-compose.dev.yml values).
NODE_ENV=development
PORT=3100
APP_URL=http://localhost:3100
DATABASE_URL=postgres://longan:longan@localhost:5433/longan
STORAGE_PATH=./data
SESSION_SECRET=change-me-to-32-or-more-random-characters-please

# Keycloak (dev realm "longan" from docker/keycloak/realm-longan.json)
OIDC_ISSUER=http://localhost:8080/realms/longan
OIDC_CLIENT_ID=longan
OIDC_CLIENT_SECRET=longan-dev-secret
OIDC_ADMIN_ROLE=longan-admin
OIDC_UPLOAD_ROLE=longan-upload
OIDC_GROUPS_CLAIM=groups
# Optional: user directory lookups through the Keycloak Admin API (service account needs realm-management/view-users)
KEYCLOAK_ADMIN_URL=http://localhost:8080

UPLOAD_MAX_BYTES=2147483648
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
LOG_LEVEL=debug
