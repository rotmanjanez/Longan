{
	"name": "@longan/client",
	"version": "0.1.0",
	"description": "Typed API client for Longan, the self-hosted photo gallery: RPC calls, uploads and Keycloak service-account tokens",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rotmanjanez/Longan.git",
		"directory": "packages/client"
	},
	"homepage": "https://github.com/rotmanjanez/Longan/tree/main/packages/client#readme",
	"keywords": [
		"longan",
		"photo-gallery",
		"orpc",
		"keycloak",
		"api-client"
	],
	"engines": {
		"node": ">=20"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/client/src/index.d.ts",
			"default": "./dist/client/src/index.js"
		},
		"./node": {
			"types": "./dist/client/src/node.d.ts",
			"default": "./dist/client/src/node.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@orpc/client": "^1.16.1",
		"@orpc/contract": "^1.16.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@orpc/server": "^1.16.1",
		"@types/node": "^24.0.0",
		"typescript": "~5.9.3",
		"vitest": "^5.1.0"
	}
}
