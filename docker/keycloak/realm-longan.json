{
	"realm": "longan",
	"enabled": true,
	"displayName": "Longan (dev)",
	"sslRequired": "none",
	"registrationAllowed": false,
	"loginWithEmailAllowed": true,
	"duplicateEmailsAllowed": false,
	"resetPasswordAllowed": false,
	"editUsernameAllowed": false,
	"bruteForceProtected": false,
	"accessTokenLifespan": 300,
	"ssoSessionIdleTimeout": 1800,
	"ssoSessionMaxLifespan": 36000,
	"roles": {
		"realm": [
			{ "name": "longan-admin", "description": "Longan administrator (bypasses all album policies)" },
			{ "name": "longan-upload", "description": "May create albums and upload photos" }
		]
	},
	"groups": [{ "name": "family", "path": "/family" }, { "name": "friends", "path": "/friends" }],
	"clients": [
		{
			"clientId": "longan",
			"name": "Longan",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": false,
			"clientAuthenticatorType": "client-secret",
			"secret": "longan-dev-secret",
			"standardFlowEnabled": true,
			"implicitFlowEnabled": false,
			"directAccessGrantsEnabled": true,
			"serviceAccountsEnabled": true,
			"frontchannelLogout": true,
			"redirectUris": ["http://localhost:3100/*", "http://localhost:5173/*"],
			"webOrigins": ["+"],
			"attributes": {
				"post.logout.redirect.uris": "+",
				"pkce.code.challenge.method": "S256"
			},
			"fullScopeAllowed": true,
			"defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email"],
			"optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"],
			"protocolMappers": [
				{
					"name": "groups",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-group-membership-mapper",
					"consentRequired": false,
					"config": {
						"full.path": "true",
						"claim.name": "groups",
						"access.token.claim": "true",
						"id.token.claim": "true",
						"userinfo.token.claim": "true",
						"introspection.token.claim": "true"
					}
				}
			]
		}
	],
	"users": [
		{
			"username": "admin",
			"enabled": true,
			"emailVerified": true,
			"firstName": "Ada",
			"lastName": "Admin",
			"email": "admin@longan.test",
			"credentials": [{ "type": "password", "value": "admin", "temporary": false }],
			"realmRoles": ["default-roles-longan", "longan-admin", "longan-upload"],
			"groups": ["/family"]
		},
		{
			"username": "alice",
			"enabled": true,
			"emailVerified": true,
			"firstName": "Alice",
			"lastName": "Liddell",
			"email": "alice@longan.test",
			"credentials": [{ "type": "password", "value": "alice", "temporary": false }],
			"realmRoles": ["default-roles-longan", "longan-upload"],
			"groups": ["/family"]
		},
		{
			"username": "bob",
			"enabled": true,
			"emailVerified": true,
			"firstName": "Bob",
			"lastName": "Builder",
			"email": "bob@longan.test",
			"credentials": [{ "type": "password", "value": "bob", "temporary": false }],
			"realmRoles": ["default-roles-longan"],
			"groups": ["/friends"]
		},
		{
			"username": "service-account-longan",
			"enabled": true,
			"serviceAccountClientId": "longan",
			"realmRoles": ["default-roles-longan"],
			"clientRoles": {
				"realm-management": ["view-users"]
			}
		}
	]
}
