{
	"name": "@longan/server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --watch --env-file-if-exists=.env src/node.ts",
		"start": "node src/node.ts",
		"start:bun": "bun src/bun.ts",
		"cli": "node --env-file-if-exists=.env src/cli/index.ts",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run --passWithNoTests",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.6",
		"@longan/shared": "workspace:*",
		"@orpc/client": "^1.16.1",
		"@orpc/contract": "^1.16.1",
		"@orpc/server": "^1.16.1",
		"drizzle-orm": "^0.45.4",
		"exifr": "^7.1.3",
		"hono": "^4.13.16",
		"jose": "^6.2.15",
		"openid-client": "^6.8.9",
		"postgres": "^4.0.0",
		"sharp": "^0.35.5",
		"yazl": "^3.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@types/yazl": "^2.4.6",
		"drizzle-kit": "^0.31.11",
		"typescript": "~5.9.3",
		"vitest": "^5.1.0"
	}
}
